# 取引所の選択です。bybit または bitget を指定します。
EXCHANGE=bybit

# Bitget を利用する場合の商品タイプです。
BITGET_PRODUCT_TYPE=usdt-futures

# 収集サイクルの間隔（秒）です。
FETCH_INTERVAL_SECONDS=300

# 同時に実行する取引所リクエスト数です。
# Bybit は IP ごとに 5 秒あたり 600 リクエスト、Bitget は Funding Rate 系 API が
# IP ごとに 1 秒あたり 20 リクエストです。Bitget では 20 以下を推奨します。
CONCURRENCY_LIMIT=10

# 異常候補としてログに記録する Funding Rate の閾値（絶対値）です。
FUNDING_RATE_THRESHOLD=0.001

# 初回取得と欠損補完で取得する履歴件数です。Bybit の上限は 200 件です。
FUNDING_RATE_HISTORY_LIMIT=200

# 通常サイクルで取得する履歴件数です。
INCREMENTAL_HISTORY_LIMIT=10

# 取引所 API のベース URL です。
BYBIT_BASE_URL=https://api.bybit.com
BITGET_BASE_URL=https://api.bitget.com

# 取引所 API のタイムアウト（秒）と最大再試行回数です。
REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRY_MAX=3

# 取引所 API のレート制限です。秒あたりのリクエスト数とバースト数を指定します。
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# SQLite のパスです。
DB_PATH=/app/data/cmma.db

# API サーバーの待ち受けアドレスとタイムアウトです。
HTTP_ADDR=:8000
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10

# API が使う SQLite 接続数の上限です。
DB_MAX_OPEN_CONNS=4

# ログ設定です。LOG_FORMAT は json または text を指定します。
LOG_FORMAT=json
LOG_LEVEL=info
